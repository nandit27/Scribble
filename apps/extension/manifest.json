{
  "manifest_version": 3,
  "name": "Scribble Overlay",
  "version": "0.1.0",
  "description": "A voice-first math tutor that floats beside the page you are studying.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open Scribble" },
  "icons": { "16": "icon.svg", "48": "icon.svg", "128": "icon.svg" }
}
